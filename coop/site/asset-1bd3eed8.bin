		<script>
	( function () {
		try {
			var m = document.cookie.match( /(?:^|;\s*)tk_qs=([^;]*)/ );
			if ( ! m || ! m[1] || /bot|crawl|spider|slurp|wp-e2e-tests/i.test( navigator.userAgent ) ) {
				return;
			}
			// Split before decoding: entries are fully %-encoded, so a raw "+" or "%20" can only be the space separator, whichever encoder wrote the cookie.
			var q = m[1].split( /%20|\+| / );
			for ( var i = 0; i < q.length; i++ ) {
				if ( ! q[ i ] ) {
					continue;
				}
				var u = 'https://pixel.wp.com/t.gif?' + decodeURIComponent( q[ i ] ) + '&_rt=' + new Date().getTime() + '&_=_';
				if ( window.fetch ) {
					fetch( u, { mode: 'no-cors', keepalive: true } ).catch( function () {} );
				} else {
					new Image().src = u;
				}
			}
			document.cookie = 'tk_qs=; path=/; domain=.wordpress.com; expires=Thu, 01 Jan 1970 00:00:00 GMT';
		} catch ( e ) {}
	} )();
	</script>
